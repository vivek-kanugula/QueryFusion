# === Database (Neon PostgreSQL with pgvector) ===
# Use postgresql+psycopg:// scheme (NOT asyncpg)
# In production on Neon:
#   DATABASE_URL: Pooled connection URI (-pooler endpoint) for app runtime
#   DATABASE_URL_DIRECT (or DATABASE_URL_UNPOOLED): Direct connection URI for Alembic migrations
DATABASE_URL=postgresql+psycopg://localhost/hybrid_rag
DATABASE_URL_DIRECT=postgresql+psycopg://localhost/hybrid_rag
# DATABASE_URL_UNPOOLED=postgresql+psycopg://localhost/hybrid_rag

# === Object Storage (Neon S3-Compatible Storage) ===
# Leave unset in local dev to skip S3 uploads; set in production for persistent file storage
# AWS_ENDPOINT_URL_S3=https://storage.your-region.example.com
# AWS_ACCESS_KEY_ID=your-neon-s3-access-key
# AWS_SECRET_ACCESS_KEY=your-neon-s3-secret-key
AWS_REGION=ap-southeast-1
S3_BUCKET=uploads

# === LLM (Google Gemini & Additional Providers) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFIER_MODEL=gemini-3.5-flash
# GROQ_API_KEY=your-groq-api-key
# OLLAMA_HOST=http://localhost:11434

# === Security ===
# In production set comma-separated explicit origins (or FRONTEND_URL) if serving a separate frontend.
# Leave unset in production when FastAPI serves the bundled SPA on the same origin.
# CORS_ORIGINS=https://your-app.example.com
# For local development the default permits localhost origins (5173, 3000, 8080, 7860).

# === Embedding & Reranking (fastembed ONNX) ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# === Local Cache Directories (Optional, local host dev only — overridden in Docker) ===
# HF_HOME=.cache/hf
# FASTEMBED_CACHE_PATH=.cache/fastembed

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080
UVICORN_WORKERS=1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080

# === Storage Quotas ===
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENTS_COUNT=50
MAX_STORAGE_MB=200
