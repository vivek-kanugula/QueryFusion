# === Database (Heroku Postgres with pgvector) ===
# Use postgresql+psycopg:// scheme (NOT asyncpg)
# Heroku sets DATABASE_URL automatically; override here for local dev
DATABASE_URL=postgresql+psycopg://localhost/hybrid_rag
DATABASE_URL_DIRECT=postgresql+psycopg://localhost/hybrid_rag

# === LLM (Google Gemini) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# === Security ===
CORS_ORIGINS=["*"]

# === Embedding & Reranking (fastembed ONNX) ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# === Local Cache Directories (Optional) ===
# HF_HOME=.cache/hf
# FASTEMBED_CACHE_PATH=.cache/fastembed
# LLM_CACHE_DIR=.cache/gemini

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
UVICORN_WORKERS=1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# === Storage Quotas ===
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENTS_COUNT=50
MAX_STORAGE_MB=200
