# === Database (Supabase / PostgreSQL with pgvector) ===
# Use postgresql+psycopg:// scheme (NOT asyncpg)
# In production on HF Spaces + Supabase:
#   DATABASE_URL: Transaction pooler URI on port 6543
#   DATABASE_URL_DIRECT: Direct connection URI on port 5432 (for migrations)
# Override here for local development
DATABASE_URL=postgresql+psycopg://localhost/hybrid_rag
DATABASE_URL_DIRECT=postgresql+psycopg://localhost/hybrid_rag

# === LLM (Google Gemini & Additional Providers) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFIER_MODEL=gemini-3.5-flash
# GROQ_API_KEY=your-groq-api-key
# OLLAMA_HOST=http://localhost:11434

# === Security ===
# In production set explicit origins; the app also allows *.hf.space via regex in production mode
# CORS_ORIGINS=https://YOUR_USERNAME-queryfusion.hf.space,https://huggingface.co
# For local development the default permits localhost origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:7860

# === Embedding & Reranking (fastembed ONNX) ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# === Local Cache Directories (Optional) ===
# HF_HOME=.cache/hf
# FASTEMBED_CACHE_PATH=.cache/fastembed
# LLM_CACHE_DIR=.cache/gemini

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
UVICORN_WORKERS=1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=7860

# === Storage Quotas ===
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENTS_COUNT=50
MAX_STORAGE_MB=200
